# FreeRise settings. Copy to .env and fill the two REQUIRED values.
# Generate each secret with:  openssl rand -base64 32

# ---------- Required ----------
# Encrypts the bank logins you save and your 2FA secret. BACK IT UP: if it is lost, saved logins
# and 2FA can't be decrypted.
CREDENTIALS_KEY=
# Signs login sessions. Changing it logs everyone out.
SESSION_SECRET=

# ---------- Database ----------
POSTGRES_USER=freerise
POSTGRES_PASSWORD=freerise
# Used when you run the API on your machine (development). Docker Compose builds its own
# address from POSTGRES_USER / POSTGRES_PASSWORD, so you can ignore these two with Docker.
DATABASE_URL=postgresql+psycopg://freerise:freerise@localhost:5432/freerise
# Tests only: this database is dropped and recreated on every test run. Never point it at real data.
TEST_DATABASE_URL=postgresql+psycopg://freerise:freerise@localhost:5432/freerise_test

# ---------- Optional ----------
# Docker: the port you open in the browser (http://localhost:3000) and which image version to run
# (latest = newest release, edge = newest build of master, or a release such as 1.0.0).
# FREERISE_PORT=3000
# FREERISE_VERSION=latest

# Set to production when the app is reachable from other devices over HTTPS: secure cookies,
# and 2FA is always required.
# FREERISE_ENV=production

# 2FA code at login. Set false to skip it while trying things locally (ignored in production).
FREERISE_LOGIN_TOTP=true

# Route bank traffic through a proxy, e.g. http://user:pass@host:port. Only needed when a bank
# blocks your server's IP (common on cloud hosts). Worker only.
FREERISE_SCRAPER_PROXY=

# Cash-flow Q&A chat over any OpenAI-compatible API (e.g. OpenRouter). Off unless all three are
# set. Only aggregated totals are sent (no account numbers or credentials).
FREERISE_LLM_BASE_URL=
FREERISE_LLM_API_KEY=
FREERISE_LLM_MODEL=

# ---------- Advanced ----------
# Session cookie name; give a second local stack (e.g. a demo) its own so logins do not clash.
FREERISE_SESSION_COOKIE=freerise_session
# Folder for screenshots when a browser scraper fails. Leave empty in production (they may show
# personal data).
FREERISE_FAILURE_SCREENSHOTS=
# Which scraper engine each bank uses, and Chrome's path: see docs/scrapers.md.
# FREERISE_IBS_PROVIDERS=all
# FREERISE_CHROME_PATH=
