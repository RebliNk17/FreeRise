POSTGRES_USER=freerise
POSTGRES_PASSWORD=freerise
DATABASE_URL=postgresql+psycopg://freerise:freerise@localhost:5432/freerise
TEST_DATABASE_URL=postgresql+psycopg://freerise:freerise@localhost:5432/freerise_test
# generate with: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
CREDENTIALS_KEY=
SESSION_SECRET=
# optional: route scraper traffic via proxy, e.g. http://user:pass@host:port (worker only).
# Works from .env locally or as a real env var on Railway.
FREERISE_SCRAPER_PROXY=
# Login 2FA code; set false to skip it locally (ignored when FREERISE_ENV=production)
FREERISE_LOGIN_TOTP=true
# Session cookie name; give a second local stack (e.g. demo) its own so logins do not clash
FREERISE_SESSION_COOKIE=freerise_session
# Folder for failure screenshots when a browser scraper fails; leave empty in production (may show personal data)
FREERISE_FAILURE_SCREENSHOTS=
# Optional cash-flow Q&A chat over an OpenAI-compatible API (e.g. OpenRouter). Off unless all three are set.
# Only aggregated totals are sent (no account numbers or credentials).
FREERISE_LLM_BASE_URL=
FREERISE_LLM_API_KEY=
FREERISE_LLM_MODEL=
